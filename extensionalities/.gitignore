# Keep source fixtures visible despite upstream's broad file-type rules.
!*.txt
!*.pdf
!*.png
!*.log
!*cache*
!*claude*
!bin/
!tmp/
!temp/

# Build products, local scratch sandbox, and secrets remain local.
target/
sandbox/
.env
.env.*

# Local verification harnesses and fixture generator remain local.
scripts/verify-settling-in.py
scripts/verify-fidelity.py
scripts/tests/test_settling_in_driver.py
fixtures/generate.py
